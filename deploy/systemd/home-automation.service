[Unit]
Description=Home Automation
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=home-automation
Group=home-automation
WorkingDirectory=/var/lib/home-automation
StateDirectory=home-automation
StateDirectoryMode=0750
EnvironmentFile=-/etc/default/home-automation
ExecStart=/opt/home-automation/start.sh
Restart=on-failure
RestartSec=5s
TimeoutStopSec=60s
UMask=0027
StandardOutput=journal
StandardError=journal
SyslogIdentifier=home-automation

[Install]
WantedBy=multi-user.target
